# TravelSense AI Environment Variables (Example)
# IMPORTANT: Do not place real secrets in this file. 
# Copy this file to a new file named '.env' and fill in your actual values.

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/travelsense

# Authentication / Security
JWT_SECRET_KEY=your_super_secret_jwt_key
JWT_ALGORITHM=HS256

# External Data APIs
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key

# Flutter Configuration
API_BASE_URL=http://localhost:8000
